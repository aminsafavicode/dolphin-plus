# ==========================
# Dolphin Flow Backend .ev.example
# ==========================

DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production hardening (enable on the deployed server, requires HTTPS/TLS):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_HSTS_PRELOAD=True

DB_NAME=dolphinflow
DB_USER=dolphin
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432

TZ=Asia/Tehran

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Backup
BACKUP_ROOT=/opt/dolphinplus/backups
# Optional OS-mounted SMB/NFS destination
BACKUP_NETWORK_ROOT=
