{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --port 5173",
    "dev:operator": "vite --config vite.operator.config.ts",
